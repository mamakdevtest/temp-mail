{"nodes": [{"id": "docs_api_overview", "label": "MS Temp Mail API", "file_type": "document", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_apikey_auth", "label": "API Key Authentication (tm_)", "file_type": "rationale", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automation uses tm_ API keys via X-Api-Key header (Bearer equivalent); web panel keeps JWT sessions. Keys carry per-key rate limits (standard 1000 req/min, master 10000 req/min), record usage count, last-used time, and IP; disabled/revoked keys return 401. Master key (tm_master_) has all scopes plus admin endpoints."}, {"id": "docs_api_scopes", "label": "API Key Scopes", "file_type": "concept", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_api_envelope", "label": "JSON Envelope Response Format", "file_type": "rationale", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON responses use {success, data} or {success:false, error, message} envelope; attachments and SSE stream excluded since binary/stream. Mail list is a flat array inside data, not nested under an emails key."}, {"id": "docs_api_longpoll", "label": "Long-Poll Email Fetching", "file_type": "rationale", "source_file": "docs/API.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /emails/:address supports wait=0..30 (max 25s recommended), after_id for only-new records, since ISO-8601 timestamp, limit 1-100, order=desc|asc (default desc); received_at is UTC ISO-8601."}, {"id": "docs_api_bulk_addresses", "label": "Bulk Address Creation", "file_type": "concept", "source_file": 